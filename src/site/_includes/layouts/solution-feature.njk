{% extends 'layouts/base.njk' %}

{% set section = 'solutions' %}
{% block pageTitle %}{{ title }} - Solutions - {{ super() }}{% endblock %}
{% block bodyId %}solution-feature{% endblock %}
{% block bodyClass %}{% endblock %}
{% block mainClass %}solution-feature-page{% endblock %}

{% if category == 'service' %}
  {% set productSolutions = collections.services %}
{% else %}
  {% set productSolutions = collections.solutions | filterByProduct(product) %}
{% endif %}
{% set previousPost = productSolutions | getPreviousCollectionItem(page) %}
{% set nextPost = productSolutions | getNextCollectionItem(page) %}

{% block content %}

{# ── Hero ──────────────────────────────────────────────────────────────────── #}
<section class="sf-hero">
  <div class="sf-hero-topbar">
    <a href="/" class="sf-card-logo" aria-label="Mortar home">
      <img src="/static/images/mortar-logo.svg" alt="Mortar" height="47">
    </a>

    <div class="sf-hero-nav-buttons">
      <div class="sf-solutions-dropdown">
        <button class="sf-solutions-toggle" aria-expanded="false" aria-haspopup="true">
          {% if category == 'service' %}Services{% else %}Solutions{% endif %}
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="6 9 12 15 18 9"></polyline></svg>
        </button>
        <ul class="sf-solutions-menu" role="menu">
          {% for solution in productSolutions %}
          <li role="none">
            <a href="{{ solution.url }}" role="menuitem"{% if solution.url == page.url %} aria-current="page"{% endif %}>{{ solution.data.title }}</a>
          </li>
          {% endfor %}
        </ul>
      </div>
      <div class="sf-products-dropdown">
        <button class="sf-products-toggle" aria-expanded="false" aria-haspopup="true">
          Products
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="6 9 12 15 18 9"></polyline></svg>
        </button>
        <ul class="sf-products-menu" role="menu">
          <li role="none"><a href="/solutions-overview/#hoopd" role="menuitem">Hoop'd</a></li>
          <li role="none"><a href="/solutions-overview/#hxly" role="menuitem">Hxly</a></li>
          <li role="none"><a href="/solutions-overview/#mortar" role="menuitem">Mortar</a></li>
        </ul>
      </div>
      <a href="/contact/" class="sf-card-contact">Contact</a>
    </div>
  </div>

  <div class="sf-hero-content">
    {# ── Left: text pane ──────────────────────────────────────────────────── #}
    <div class="sf-hero-text-pane">
      <span class="sf-hero-eyebrow">{% if category == 'service' %}Service{% else %}Solution{% endif %}</span>
      <h1 class="sf-hero-tagline">{{ title }}</h1>

      {% if hero_slides %}
        {% for slide in hero_slides %}
        <div class="sf-hero-slide{% if loop.first %} is-active{% endif %}">
          <h2 class="sf-hero-subheading">{{ slide.heading }}</h2>
          {% if slide.body %}<p class="sf-hero-desc">{{ slide.body }}</p>{% endif %}
        </div>
        {% endfor %}
      {% else %}
        <div class="sf-hero-slide is-active">
          {% if strapline %}
            <p class="sf-hero-desc">{{ strapline }}</p>
          {% elif description %}
            <p class="sf-hero-desc">{{ description }}</p>
          {% endif %}
        </div>
      {% endif %}

      <a href="/contact/" class="sf-hero-cta">Get in touch</a>

      {% if hero_slides and hero_slides | length > 1 %}
      <div class="sf-hero-arrows">
        <button class="sf-hero-prev" aria-label="Previous slide">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="15 18 9 12 15 6"></polyline></svg>
        </button>
        <button class="sf-hero-next" aria-label="Next slide">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="9 6 15 12 9 18"></polyline></svg>
        </button>
      </div>
      {% endif %}
    </div>

    {# ── Right: image pane ────────────────────────────────────────────────── #}
    <div class="sf-hero-image-pane">
      {% if hero_slides %}
        {% for slide in hero_slides %}
          {% if slide.image %}
          <img class="sf-hero-img{% if loop.first %} is-active{% endif %}"
               src="{{ slide.image }}" alt="{{ slide.heading }}">
          {% endif %}
        {% endfor %}
      {% elif image %}
        <img class="sf-hero-img is-active" src="{{ image }}" alt="{{ title }}">
      {% endif %}
    </div>
  </div>
</section>

<script>
(function () {
  // ── Solutions dropdown ──────────────────────────────────────────────────
  var dropdown = document.querySelector('.sf-solutions-dropdown');
  var toggle   = dropdown && dropdown.querySelector('.sf-solutions-toggle');
  if (toggle) {
    toggle.addEventListener('click', function (e) {
      e.stopPropagation();
      var open = dropdown.classList.toggle('is-open');
      toggle.setAttribute('aria-expanded', open ? 'true' : 'false');
    });
    document.addEventListener('click', function () {
      dropdown.classList.remove('is-open');
      toggle.setAttribute('aria-expanded', 'false');
    });
    dropdown.querySelector('.sf-solutions-menu').addEventListener('click', function (e) {
      e.stopPropagation();
    });
  }

  // ── Products dropdown ───────────────────────────────────────────────────
  var pdropdown = document.querySelector('.sf-products-dropdown');
  var ptoggle   = pdropdown && pdropdown.querySelector('.sf-products-toggle');
  if (ptoggle) {
    ptoggle.addEventListener('click', function (e) {
      e.stopPropagation();
      var open = pdropdown.classList.toggle('is-open');
      ptoggle.setAttribute('aria-expanded', open ? 'true' : 'false');
    });
    document.addEventListener('click', function () {
      pdropdown.classList.remove('is-open');
      ptoggle.setAttribute('aria-expanded', 'false');
    });
    pdropdown.querySelector('.sf-products-menu').addEventListener('click', function (e) {
      e.stopPropagation();
    });
  }

  {% if hero_slides and hero_slides | length > 1 %}
  // ── Slide carousel ─────────────────────────────────────────────────────
  var hero = document.querySelector('.sf-hero-content');
  if (hero) {
    var textSlides = Array.from(hero.querySelectorAll('.sf-hero-slide'));
    var imgSlides  = Array.from(hero.querySelectorAll('.sf-hero-img'));
    var total = textSlides.length;
    var current = 0;

    function goTo(n) {
      textSlides[current].classList.remove('is-active');
      if (imgSlides[current]) imgSlides[current].classList.remove('is-active');
      current = ((n % total) + total) % total;
      textSlides[current].classList.add('is-active');
      if (imgSlides[current]) imgSlides[current].classList.add('is-active');
    }

    var prev = hero.querySelector('.sf-hero-prev');
    var next = hero.querySelector('.sf-hero-next');
    if (prev) prev.addEventListener('click', function () { goTo(current - 1); });
    if (next) next.addEventListener('click', function () { goTo(current + 1); });
  }
  {% endif %}

  {% if case_studies and case_studies | length > 0 %}
  // ── Case study carousel ──────────────────────────────────────────────────
  // Deferred: case study HTML lives after this script tag in the document
  document.addEventListener('DOMContentLoaded', function () {
    var csViewport = document.querySelector('.sf-case-study-viewport');
    var csTrack    = csViewport && csViewport.querySelector('.sf-case-study-items');
    var csItems    = csTrack ? Array.from(csTrack.querySelectorAll('.sf-case-study-item')) : [];
    var csDotsEl   = document.querySelector('.sf-cs-dots');
    var csPrevBtn  = document.querySelector('.sf-cs-prev');
    var csNextBtn  = document.querySelector('.sf-cs-next');
    var csTotal    = csItems.length;
    var csCurrent  = csTotal >= 3 ? Math.floor((csTotal - 1) / 2) : 0;

    if (!csTrack || !csItems.length) return;

    function csCalcOffset(idx) {
      var gap = parseFloat(getComputedStyle(csTrack).columnGap) || 24;
      var cardWidth = csItems[0].offsetWidth;
      var centerOffset = (csViewport.offsetWidth - cardWidth) / 2;
      return centerOffset - idx * (cardWidth + gap);
    }
    function csUpdate() {
      csTrack.style.transform = 'translateX(' + csCalcOffset(csCurrent) + 'px)';
      csItems.forEach(function (item, i) {
        item.classList.toggle('is-active', i === csCurrent);
      });
      if (csDotsEl) {
        csDotsEl.innerHTML = '';
        for (var i = 0; i < csTotal; i++) {
          var dot = document.createElement('button');
          dot.className = 'sf-cs-dot' + (i === csCurrent ? ' is-active' : '');
          dot.setAttribute('aria-label', 'Go to slide ' + (i + 1));
          (function (idx) { dot.addEventListener('click', function () { csGoTo(idx); }); }(i));
          csDotsEl.appendChild(dot);
        }
      }
      if (csPrevBtn) csPrevBtn.disabled = csCurrent === 0;
      if (csNextBtn) csNextBtn.disabled = csCurrent >= csTotal - 1;
    }
    function csGoTo(n) {
      csCurrent = Math.max(0, Math.min(n, csTotal - 1));
      csUpdate();
    }
    if (csPrevBtn) csPrevBtn.addEventListener('click', function () { csGoTo(csCurrent - 1); });
    if (csNextBtn) csNextBtn.addEventListener('click', function () { csGoTo(csCurrent + 1); });
    window.addEventListener('resize', function () { csUpdate(); });

    // Position without transition so there's no animated entry on load
    requestAnimationFrame(function () {
      csTrack.style.transition = 'none';
      csUpdate();
      requestAnimationFrame(function () { csTrack.style.transition = ''; });
    });
  });
  {% endif %}
}());
</script>

{# ── Overview / intro ──────────────────────────────────────────────────────── #}
<section class="sf-overview" id="sf-overview">
  <div class="wrapper">
    <span class="sf-eyebrow">{{ overview_eyebrow if overview_eyebrow else 'Introduction' }}</span>
    <h2 class="sf-section-heading">{{ overview_heading if overview_heading else 'What is the ' + title }}</h2>
    <div class="sf-overview-body">
      {{ content | safe }}
    </div>
  </div>
</section>

{# ── How it works ──────────────────────────────────────────────────────────── #}
{% if steps %}
<section class="sf-how">
  <div class="wrapper">
    <div class="sf-section-header">
      <span class="sf-eyebrow">{{ steps_eyebrow if steps_eyebrow else 'How it works' }}</span>
      <h2 class="sf-section-heading">{{ steps_heading if steps_heading else 'How it works' }}</h2>
    </div>
    <div class="sf-steps">
      {% for step in steps %}
      <div class="sf-step">
        <h3>{{ step.title }}</h3>
        <p>{{ step.body }}</p>
      </div>
      {% endfor %}
    </div>
  </div>
</section>
{% endif %}

{# ── Key features ──────────────────────────────────────────────────────────── #}
{% if features %}
<section class="sf-features-section">
  <div class="wrapper">
    <div class="sf-section-header">
      <span class="sf-eyebrow">{{ features_eyebrow if features_eyebrow else 'Key features' }}</span>
      <h2 class="sf-section-heading">{{ features_heading if features_heading else 'Everything you need' }}</h2>
    </div>
    <div class="sf-features">
      {% for feature in features %}
      <div class="sf-feature">
        <h3>{{ feature.title }}</h3>
        <p>{{ feature.body }}</p>
      </div>
      {% endfor %}
    </div>
  </div>
</section>
{% endif %}

{# ── Benefits ──────────────────────────────────────────────────────────────── #}
{% if benefits %}
<section class="sf-benefits">
  <div class="wrapper">
    <div class="sf-section-header">
      <span class="sf-eyebrow">{{ benefits_eyebrow if benefits_eyebrow else 'Why it matters' }}</span>
      <h2 class="sf-section-heading">{{ benefits_heading if benefits_heading else 'Built for impact' }}</h2>
    </div>
    <div class="sf-benefits-grid">
      {% for benefit in benefits %}
      <div class="sf-benefit">
        <h3>{{ benefit.title }}</h3>
        <p>{{ benefit.body }}</p>
      </div>
      {% endfor %}
    </div>
  </div>
</section>
{% endif %}

{# ── Case studies ──────────────────────────────────────────────────────────── #}
{% if case_studies %}
<section class="sf-case-study">
  <div class="sf-case-study-inner">
    <div class="sf-section-header">
      <span class="sf-eyebrow">Case studies</span>
      <h2 class="sf-section-heading">In practice</h2>
    </div>
    <div class="sf-case-study-viewport">
      <div class="sf-case-study-items">
        {% for study in case_studies %}
        <div class="sf-case-study-item">
          <p>{{ study.text }}</p>
          <a href="{{ study.link }}">{{ study.label if study.label else 'Read more' }}</a>
        </div>
        {% endfor %}
      </div>
    </div>
    {% if case_studies | length > 1 %}
    <div class="sf-case-study-nav">
      <button class="sf-cs-prev" aria-label="Previous case study">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="15 18 9 12 15 6"></polyline></svg>
      </button>
      <div class="sf-cs-dots" aria-hidden="true"></div>
      <button class="sf-cs-next" aria-label="Next case study">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="9 6 15 12 9 18"></polyline></svg>
      </button>
    </div>
    {% endif %}
  </div>
</section>
{% endif %}

{# ── Footer ────────────────────────────────────────────────────────────────── #}
<footer class="sf-footer">
  <a href="/" class="sf-footer-logo" aria-label="Mortar home">
    <img src="/static/images/mortar-logo.svg" alt="Mortar" height="47">
  </a>
  <span class="sf-footer-copy">© 2026 Mortar Works</span>
  <a href="/contact/" class="sf-footer-cta">Get in touch</a>
</footer>

{% endblock %}
